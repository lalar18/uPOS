{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usystemspos",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // OAuth client ID for "Continue with Google" (Google Cloud Console > APIs & Services > Credentials).
    // Its secret is not stored here: `npx wrangler secret put GOOGLE_CLIENT_SECRET` (and .dev.vars locally).
    "GOOGLE_CLIENT_ID": "436051304053-672gmbt3lk7u5pils95keft1bhu790i2.apps.googleusercontent.com"
  },
  // Checks the withdrawals being sent through PayMongo (worker/payoutTransfers.ts)
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Replace with values from `npx wrangler d1 list` or the Cloudflare dashboard
      "database_name": "usystems_pos_db",
      "database_id": "96978b79-41df-473d-a591-44dea0f036a4",
      "migrations_dir": "migrations"
    }
  ]
}
